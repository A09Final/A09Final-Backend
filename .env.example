# Copy this file to .env and fill in the values. Do not commit .env.
# Write the values without quotation marks.

# --- Ports on the Mac ---
# Change a port when another program on the Mac already uses it.
# The ESP32 uses MQTT_PORT. The app uses HTTP_PORT.
MQTT_PORT=1883
HTTP_PORT=8080

# --- MQTT (the backend user in Mosquitto) ---
MQTT_USERNAME=backend
# Use a long random value, for example: openssl rand -base64 24
MQTT_PASSWORD=change-me
# MQTT_KEEPALIVE=30s

# --- APNs (Apple Developer account > Certificates, IDs & Profiles > Keys) ---
# true: write notifications to the log only. false: send them to the iPhone.
APNS_DRY_RUN=true
# Put the .p8 file in ./secrets/AuthKey.p8 (docker-compose.yml sets APNS_KEY_FILE).
APNS_KEY_ID=99AHD8A977
APNS_TEAM_ID=LF442H2D9J
# Bundle ID of the BeforeFire app target.
APNS_TOPIC=com.ibnu.BeforeFire
# development: app installed from Xcode. production: TestFlight or App Store.
APNS_ENVIRONMENT=development

# --- Alerts ---
# APNs stops trying to deliver an alert after this time.
ALERT_EXPIRY=15m
# Must not be shorter than ALERT_EXPIRY.
ALERT_DEDUPE_WINDOW=30m
# time-sensitive needs the Time Sensitive Notifications capability in the app.
# critical needs the Critical Alerts entitlement from Apple.
ALARM_INTERRUPTION_LEVEL=time-sensitive

# --- Commands from the app ---
COMMAND_ANSWER_TIMEOUT=8s
COMMAND_CLOCK_SKEW=5m

# --- Sensor readings for the app ---
# The app marks readings as old ("isStale") after this time without new telemetry.
TELEMETRY_STALE_AFTER=30s

LOG_LEVEL=info
